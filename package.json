{
  "name": "meow-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server.ts",
    "test": "tsx --test tests/*.test.ts web/features/plugin-lab/host.test.ts",
    "check": "tsc --noEmit",
    "test:e2e": "node scripts/system-tests.mjs",
    "test:e2e:shared": "playwright test",
    "format": "prettier --write src web packages tests e2e",
    "format:check": "prettier --check src web packages tests e2e",
    "test:architecture": "tsx --test tests/architecture.test.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "@modelcontextprotocol/sdk": "1.32.2",
    "better-auth": "1.7.20",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  }
}
